# Copy to .env and fill in. .env is gitignored and never baked into the image.
# Everything below is optional: with none of it set the system still runs, offline,
# and scores 28/30 on the provided files.

# Turns on the vision tier. Without it, photos whose chemistry OCR garbles are sent to
# Needs Review rather than re-read. With it, they get decided.
GEMINI_API_KEY=

# Optional overrides.
# GEMINI_MODEL=gemini-3-flash-preview
# JUDGE_MODEL=gemini-3-flash-preview

# Turns on Phoenix tracing. Off unless the collector endpoint is set.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/your-space
# PHOENIX_API_KEY=
# PHOENIX_PROJECT_NAME=product-safety-compliance
